<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_nav</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/text_primary</item>
        <item name="colorPrimary">@color/purple_accent</item>
        <item name="colorOnPrimary">@color/primary_button_text</item>
        <item name="colorSecondary">@color/purple_accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/button_secondary_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.BottomNavigation" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
