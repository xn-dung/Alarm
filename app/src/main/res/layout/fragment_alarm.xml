<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good evening" android:textColor="@color/text_secondary" android:textSize="15sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Alarms" android:textColor="@color/text_primary" android:textSize="34sp" android:textStyle="bold"/></LinearLayout>
   <TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_icon_button" android:gravity="center" android:text="•••" android:textColor="@color/text_primary" android:textSize="16sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/card_next_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_next_alarm" android:orientation="vertical" android:padding="20dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT ALARM" android:textColor="@color/purple_light" android:textSize="12sp" android:textStyle="bold"/>
   <TextView android:id="@+id/tv_next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="No alarm set" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold"/>
   <TextView android:id="@+id/tv_next_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Add one and let us wake you gently" android:textColor="@color/text_secondary" android:textSize="14sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Your alarms" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textColor="@color/purple_light" android:textSize="15sp"/></LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alarms" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:clipToPadding="false" android:paddingBottom="76dp"/>
 </LinearLayout>
 <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_add" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="bottom|end" android:layout_margin="22dp" android:contentDescription="Add alarm" android:src="@android:drawable/ic_input_add" android:tint="@color/bg_dark" app:backgroundTint="@color/accent_warm" app:fabCustomSize="56dp"/>
</FrameLayout>
